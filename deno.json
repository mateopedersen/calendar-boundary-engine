{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@betacalendars/calendar-boundary-engine",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./date": "./src/date/mod.ts",
    "./gregorian": "./src/gregorian/mod.ts",
    "./julian": "./src/julian/mod.ts",
    "./julian-day": "./src/julian-day/mod.ts",
    "./iso-week": "./src/iso-week/mod.ts",
    "./grid": "./src/grid/mod.ts",
    "./boundary": "./src/boundary/mod.ts",
    "./reform": "./src/reform/mod.ts"
  },
  "tasks": {
    "check": "deno check src/mod.ts tests/*.ts examples/*.ts benchmarks/*.ts",
    "test": "deno test",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "doc:lint": "deno doc --lint src/mod.ts src/date/mod.ts src/gregorian/mod.ts src/julian/mod.ts src/julian-day/mod.ts src/iso-week/mod.ts src/grid/mod.ts src/boundary/mod.ts src/reform/mod.ts",
    "doc:html": "deno doc --html --output=docs-generated/ src/mod.ts",
    "publish:dry-run": "deno publish --dry-run"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  }
}
